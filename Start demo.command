#!/bin/bash
# macOS: double-click this file to start the demo. It opens http://localhost:3000 when it's ready.
# Keep the Terminal window open while you look at the demo; close it to stop.
# (The earlier Python + Next.js demo is still available: bash demo/run_demo.sh)
cd "$(dirname "$0")" && bash demo/run_php_demo.sh
echo; read -r -p "Press Enter to close this window." _
