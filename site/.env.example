# Elite Escorts Europe — settings. Copy this file to ".env" and fill it in.

APP_NAME="Elite Escorts Europe"
APP_ENV=production
APP_DEBUG=false
# Generate once with:  php artisan key:generate
APP_KEY=
# Public address of the site (links in e-mails, sitemap, canonical links)
APP_URL=https://www.eliteescortseurope.eu
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=warning

# Database: MySQL / MariaDB from the hosting package
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=eee
DB_USERNAME=
DB_PASSWORD=

# No database tables are needed for these
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# E-mail through Resend (resend.com): API key with "Sending access"
RESEND_API_KEY=
SENDER_EMAIL=info@eliteescortseurope.eu
REPORT_EMAIL=info@eliteescortseurope.eu

# Payments (temporary, Stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: visitor IP → location for "nearest first" on Browse (ipgeolocation.io)
IPGEOLOCATION_API_KEY=

# Optional: folder for uploaded photos and videos (default: storage/app/uploads)
# UPLOAD_DIR=
